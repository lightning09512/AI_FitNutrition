<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp"
    android:paddingHorizontal="16dp">

    <!-- User message (right) -->
    <LinearLayout android:id="@+id/layoutUser"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_user"
            android:textColor="@color/bg_primary"
            android:textSize="14sp" android:fontFamily="sans-serif"
            android:paddingHorizontal="14dp" android:paddingVertical="10dp"
            android:lineSpacingMultiplier="1.3"/>
        <TextView android:id="@+id/tvUserTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/text_tertiary" android:textSize="10sp"
            android:fontFamily="sans-serif" android:layout_marginTop="3dp"/>
    </LinearLayout>

    <!-- AI message (left) -->
    <LinearLayout android:id="@+id/layoutAi"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_chat" android:tint="@color/accent_teal"
                android:layout_marginEnd="6dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FitBot"
                android:textColor="@color/accent_teal" android:textSize="11sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView android:id="@+id/tvAiMessage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai"
            android:textColor="@color/text_primary"
            android:textSize="14sp" android:fontFamily="sans-serif"
            android:paddingHorizontal="14dp" android:paddingVertical="10dp"
            android:lineSpacingMultiplier="1.3"/>
        <TextView android:id="@+id/tvAiTime"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary" android:textSize="10sp"
            android:fontFamily="sans-serif" android:layout_marginTop="3dp"/>
    </LinearLayout>

</FrameLayout>
