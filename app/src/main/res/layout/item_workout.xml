<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    style="@style/Widget.AIFitNutrition.Card"
    app:cardCornerRadius="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tvWorkoutEmoji"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="🏃"
            android:textSize="24sp" android:background="@drawable/bg_stat_box"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/tvWorkoutType"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="15sp"
                android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/tvWorkoutDetails"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"
                android:fontFamily="sans-serif" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/tvWorkoutCalories"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent_orange" android:textSize="18sp"
                android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="kcal" android:textColor="@color/text_tertiary"
                android:textSize="10sp" android:fontFamily="sans-serif"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btnDeleteWorkout"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_tertiary"
            android:contentDescription="Delete workout"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
