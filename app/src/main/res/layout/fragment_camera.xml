<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"/>

    <!-- Top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp"
        android:paddingTop="48dp" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCamera"
            android:layout_width="52dp" android:layout_height="52dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:backgroundTint="#99000000"
            app:cornerRadius="26dp"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart" app:iconPadding="0dp"
            app:iconSize="24dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan Your Food"
            android:textColor="@color/text_primary" android:textSize="18sp"
            android:textStyle="bold" android:fontFamily="sans-serif-medium"
            android:gravity="center"/>
        <View android:layout_width="52dp" android:layout_height="52dp"/>
    </LinearLayout>

    <!-- Scanning guide overlay -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Point at your food"
            android:textColor="#AAFFFFFF" android:textSize="14sp"
            android:fontFamily="sans-serif" android:layout_marginBottom="200dp"/>
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:padding="32dp" android:gravity="center">

        <!-- AI analyzing indicator -->
        <LinearLayout android:id="@+id/layoutAnalyzing"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="#AA000000" android:paddingHorizontal="20dp"
            android:paddingVertical="10dp" android:layout_marginBottom="24dp"
            android:visibility="gone">
            <ProgressBar android:layout_width="20dp" android:layout_height="20dp"
                style="?android:attr/progressBarStyleSmall"
                android:indeterminateTint="@color/accent_teal" android:layout_marginEnd="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AI is analyzing…"
                android:textColor="@color/text_primary" android:textSize="14sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Capture button -->
        <FrameLayout android:layout_width="80dp" android:layout_height="80dp"
            android:id="@+id/btnCapture">
            <View android:layout_width="80dp" android:layout_height="80dp"
                android:background="@drawable/bg_capture_button"/>
            <View android:layout_width="64dp" android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_capture_inner"/>
        </FrameLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tap to capture" android:textColor="#88FFFFFF"
            android:textSize="12sp" android:fontFamily="sans-serif"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

</FrameLayout>
