<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="96dp">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingTop="24dp" android:paddingBottom="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Nutrition Log"
                    android:textColor="@color/text_primary" android:textSize="24sp"
                    android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tv_total_calories_today"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 kcal" android:textColor="@color/accent_teal"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium"
                    tools:text="1250 kcal"/>
            </LinearLayout>

            <!-- Meal type Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@color/bg_card"
                app:tabIndicatorColor="@color/accent_teal"
                app:tabSelectedTextColor="@color/accent_teal"
                app:tabTextColor="@color/text_secondary"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabRippleColor="@null"
                style="@style/Widget.Material3.TabLayout"/>

            <!-- Food list per meal -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFoodLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_food_log"/>

            <TextView android:id="@+id/tv_empty_meal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:text="No food logged for this meal yet.\nTap + to add food!"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="Add Food"
        app:backgroundTint="@color/accent_teal"
        app:tint="@color/bg_primary"
        app:srcCompat="@android:drawable/ic_input_add"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
