<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.AIFitNutrition" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorPrimaryContainer">@color/bg_card</item>
        <item name="colorOnPrimaryContainer">@color/accent_teal_light</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="colorSecondaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnSecondaryContainer">@color/accent_violet_light</item>
        <item name="colorTertiary">@color/accent_orange</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.AIFitNutrition.Splash" parent="Theme.AIFitNutrition">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.AIFitNutrition.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nav_bg</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <!-- itemActiveIndicatorColor is set in activity_main.xml to avoid linking issues in some Gradle versions -->
    </style>

    <!-- Card style -->
    <style name="Widget.AIFitNutrition.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/bg_card_elevated</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.AIFitNutrition.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AIFitNutrition.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_teal</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.AIFitNutrition.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AIFitNutrition.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>